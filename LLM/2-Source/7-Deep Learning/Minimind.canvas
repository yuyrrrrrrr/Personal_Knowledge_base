			"height":60,
			"color":"1"
		},
		{
			"id":"2b1a015d8bc00232",
			"type":"text",
			"text":"- DDP 多卡分布式训练支持",
			"styleAttributes":{},
			"x":905,
			"y":-180,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"1ec769b945389549",
			"type":"text",
			"text":"推理脚本，加载训练好的模型权重，在命令行中与模型对话：\n```python\n# 核心流程\ntokenizer = AutoTokenizer.from_pretrained(model_path)\nmodel = MiniMindForCausalLM.from_pretrained(model_path)\n# 自回归生成\ngenerated_ids = model.generate(\n    inputs=inputs[\"input_ids\"],\n    max_new_tokens=args.max_new_tokens,\n    do_sample=True,\n    top_p=args.top_p,\n    temperature=args.temperature,\n)\n```",
			"styleAttributes":{},
			"x":905,
			"y":-70,
			"width":550,
			"height":360,
			"color":"1"
		},
		{
			"id":"a85a9cf843a6492e",
			"type":"text",
			"text":"整个项目最重要的文件, 所有模型结构都包含在此",
			"styleAttributes":{},
			"x":905,
			"y":-1030,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"60b5e6d25ad33dd1",
			"type":"text",
			"text":"|类名|作用|对应概念|\n|---|---|---|\n|`MiniMindConfig`|模型配置|定义所有超参数（隐藏层大小、层数、头数等）|\n|`RMSNorm`|归一化层|L02 中讲的 Layer Normalization（简化版）|\n|`Attention`|注意力机制|L02 中讲的 Self-Attention + GQA + RoPE|\n|`FeedForward`|前馈网络|L02 中讲的 SwiGLU FFN|\n|`MoEGate` / `MOEFeedForward`|专家混合|MoE 版本的 FFN（高级话题）|\n|`MiniMindBlock`|Transformer 块|一层完整的 Transformer（Pre-Norm + Attention + FFN + 残差）|\n|`MiniMindModel`|模型主体|Embedding + N × Block + 最终 RMSNorm|\n|`MiniMindForCausalLM`|因果语言模型|MiniMindModel + lm_head + 损失计算 + 生成|",
			"styleAttributes":{},
			"x":915,
			"y":-930,
			"width":700,
			"height":400,
			"color":"1"
		},
		{
			"id":"5a48526874df24ba",
			"type":"text",
			"text":"核心配置参数表",
			"styleAttributes":{},
			"x":1735,
			"y":-830,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"2f8d630d02f08615",
			"type":"text",
			"text":"重点文件",
			"styleAttributes":{},
			"x":295,
			"y":-730,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"89b8225a7126f9bc",
