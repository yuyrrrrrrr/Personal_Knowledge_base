		{"id":"f4aef3ca7b608924","type":"file","file":"image/Pasted image 20261101111636.png","x":1278,"y":2077,"width":399,"height":140},
		{
			"id":"64d4c38299024738",
			"type":"text",
			"text":"只有一个数",
			"styleAttributes":{},
			"x":1417,
			"y":2227,
