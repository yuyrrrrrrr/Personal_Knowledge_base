		{"id":"b9645e48-8107-5f","type":"text","text":"AutoModelForSequenceClassification.from_pretrained","x":-2650,"y":4008,"width":300,"height":70},
		{"id":"af15a768-a163-52","type":"text","text":"数据转张量","x":-2250,"y":4334,"width":300,"height":64},
		{"id":"1a080bdb-f1e6-52","type":"text","text":"tokenizer.encode：返回张量，数值是 token 索引","x":-2650,"y":4102,"width":300,"height":70},
		{"id":"c69516ca-96fb-55","type":"text","text":"tokenizer.encode_plus：返回字典","x":-2650,"y":4196,"width":300,"height":64},
		{"id":"d9219e29-18d8-5f","type":"text","text":"字段 input_ids：token 索引","x":-2650,"y":4284,"width":300,"height":64},
		{"id":"9a9b873e-d81d-52","type":"text","text":"字段 token_type_ids：区分句子，常可忽略","x":-2650,"y":4372,"width":300,"height":70},
		{"id":"fec9cea5-0ce7-52","type":"text","text":"字段 attention_mask：1 真实值，0 填充值","x":-2650,"y":4466,"width":300,"height":70},
		{"id":"729963a0-17fa-5b","type":"text","text":"参数：文本 / return_tensors=\"pt\" / padding / truncation / max_length","x":-2650,"y":4560,"width":300,"height":70},
