			"y":2097,
			"width":260,
			"height":60,
			"color":"3"
		},
		{
			"id":"9cd126131a4442b9",
			"type":"text",
			"text":"多维数组,以类的形式封装起来\n类型:\n\t0维张量:标量, 一个单独的数\n\t1维张量: 数组[1,2,3]\n\t2维张量:二维数组,矩阵\n\t3维及以上,高阶张量",
			"styleAttributes":{},
			"x":2217,
			"y":1987,
			"width":260,
			"height":220,
			"color":"3"
		},
		{
			"id":"811ce8d89369bd98",
			"type":"text",
			"text":"增加维度",
			"styleAttributes":{},
			"x":2687,
			"y":3440,
			"width":260,
			"height":60,
			"color":"3"
		},
		{
			"id":"0c1e510fb74b9617",
			"type":"text",
