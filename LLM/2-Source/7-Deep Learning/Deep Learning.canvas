		{"id":"d1b86fa538b7a276","type":"file","file":"LLM/2-Source/7-Deep Learning/4-Transformer/4-为什么是 Decoder-Only的 GPT赢了.md","x":-1180,"y":1777,"width":400,"height":467},
		{
			"id":"c8be1a5c3d5a03f9",
