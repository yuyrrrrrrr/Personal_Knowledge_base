			"styleAttributes":{},
			"x":2287,
			"y":3500,
			"width":260,
			"height":60,
			"color":"3"
		},
		{
			"id":"c976847ccb9e7910",
			"type":"text",
			"text":"dim等于几, 增加那个轴",
