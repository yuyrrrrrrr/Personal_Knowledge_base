			"y":2837,
			"width":260,
			"height":60,
			"color":"3"
		},
		{
			"id":"a24f53b197e94a26",
			"type":"text",
			"text":"a.add(b)",
			"styleAttributes":{},
			"x":1757,
			"y":2937,
			"width":260,
			"height":60,
			"color":"3"
		},
