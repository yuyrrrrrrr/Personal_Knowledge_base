		{"id":"f64bed54-c78b-52","type":"text","text":"BertForSequenceClassification.from_pretrained(\"bert-base-chinese\")","x":-2250,"y":5148,"width":300,"height":70},
		{"id":"0abfd2dc-c1ec-50","type":"text","text":"按任务替换分类头，设置 num_labels","x":-2250,"y":5242,"width":300,"height":64},
