			"height":60
		},
		{
			"id":"0588af1f8895275b",
			"type":"text",
			"text":"不同维数张量",
			"styleAttributes":{},
			"x":1097,
			"y":2327,
			"width":260,
			"height":60
		},
		{
			"id":"7f12be59a633a589",
			"type":"text",
			"text":"一阶, 一维张量",
