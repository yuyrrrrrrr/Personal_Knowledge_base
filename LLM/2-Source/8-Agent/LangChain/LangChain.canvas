{
	"nodes":[
		{"id":"4a8231cf7e847d24","type":"text","text":"LangChain 开发学习路线","x":0,"y":116,"width":250,"height":68,"color":"1"},
		{"id":"1744949607fa8c3e","type":"text","text":"阶段 1：AI 大模型基础","x":570,"y":-3043,"width":250,"height":60,"color":"1"},
