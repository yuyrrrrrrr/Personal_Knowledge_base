		{"id":"9c15dddb759b5e3e","type":"file","file":"image/Pasted image 20261119181118.png","x":0,"y":-818,"width":692,"height":761},
		{
			"id":"650c5acdfc820e9e",
			"type":"text",
			"text":"# **RAG 效果 = 文档质量 x 解析质量 x 切分质量 x 检索质量 x 重排质量 x Prompt 组织质量 x 生成模型质量 x 评测闭环**\n这里的乘号表示：只要某个环节特别差，整体效果就会被明显拉低。",
			"styleAttributes":{},
			"x":-420,
			"y":-818,
			"width":420,
			"height":214
		}
	],
