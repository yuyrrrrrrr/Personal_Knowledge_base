			"height":60,
			"color":"1"
		},
		{
			"id":"ebf2935c399dc1ea",
			"type":"text",
			"text":"Fetch + ReadableStream",
			"styleAttributes":{},
			"x":2340,
			"y":-300,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"a5c2708fe3d3081d",
			"type":"text",
			"text":"浏览器原生接收SSE, 并还原完整事件.\n只支持GET, 不能提交 POST请求体, 也没有设置任意自定义请求头的接口.",
			"styleAttributes":{},
			"x":2660,
			"y":-460,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"bc9528c49d9a8069",
			"type":"text",
			"text":"通过 POST 提交模型参数和对话历史, 同时持续读取响应体.\n请求能力更完整, SSE的事件边界需要自行解析.",
			"styleAttributes":{},
			"x":2640,
			"y":-300,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"2a725c447857f3b7",
			"type":"text",
			"text":"提交输入并接收流式结果, 可以放在同一次 POST 请求中.",
			"styleAttributes":{},
			"x":2340,
			"y":-360,
			"width":260,
			"height":60,
			"color":"1"
		},
