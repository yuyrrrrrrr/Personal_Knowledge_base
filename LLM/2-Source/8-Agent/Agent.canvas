		{"id":"d88f067c6b3a4ea2","type":"text","text":"# RAG系统: 知识检索增强","x":1048,"y":5126,"width":377,"height":67,"color":"2"},
		{
			"id":"09d2d6409ffdeb45",
			"type":"text",
			"text":"### 记忆系统的工作流程",
			"styleAttributes":{},
			"x":-260,
			"y":3707,
			"width":260,
			"height":60,
			"color":"2"
		},
		{
			"id":"7b55d1ff0715ae2a",
			"type":"text",
			"text":"### MemoryManager详解",
			"styleAttributes":{},
			"x":-260,
			"y":4586,
			"width":260,
