			"height":60,
			"color":"2"
		},
		{
			"id":"478b2495775f6c5f",
			"type":"text",
			"text":"DSH (万物皆插件)",
			"styleAttributes":{},
			"x":4700,
			"y":70,
			"width":260,
			"height":60,
			"color":"2"
		},
		{
			"id":"cd96b0b12abf5a06",
