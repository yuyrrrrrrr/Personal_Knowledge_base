			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"8390d4c5f732e470",
			"type":"text",
			"text":"Responses(OpenAI)",
			"styleAttributes":{},
			"x":1892,
			"y":-777,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"68a80a0a7d6b393f",
			"type":"text",
			"text":"通过项目配置文件 (.env)",
			"styleAttributes":{},
			"x":2407,
			"y":-673,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"0eab1d0c11fbccb7",
			"type":"text",
			"text":"通过全局环境变量",
			"styleAttributes":{},
			"x":2407,
			"y":-593,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"fb2a9926df256e8a",
			"type":"text",
			"text":"调用大模型 API，通常需要配置两个关键参数：`api_key` 和 `base_url`。\n\n- **API Key**：用于身份认证，证明当前请求有权访问对应的模型服务；\n- **Base URL**：指定 API 请求发送到哪个服务端地址，SDK 会在此基础上拼接具体的 API 路径，完成 HTTP 请求。",
			"styleAttributes":{},
			"x":1927,
			"y":-673,
			"width":330,
			"height":140,
			"color":"1"
		},
		{
			"id":"6be47600059a17b4",
			"type":"text",
			"text":"兼容接口让应用能用相近的代码接入不同模型服务, 降低迁移成本.",
			"styleAttributes":{},
			"x":1637,
			"y":-713,
			"width":260,
			"height":79,
			"color":"1"
		},
