		{"id":"385e0705589d9346","type":"text","text":"LangChain","x":-1920,"y":-1658,"width":250,"height":60,"color":"3"},
		{"id":"2b0ebff22b83fea6","type":"text","text":"AutoGPT","x":-1920,"y":-1566,"width":250,"height":60,"color":"3"},
		{"id":"e40ee80753779e2b","type":"text","text":"BabyAGI","x":-1920,"y":-1474,"width":250,"height":60,"color":"3"},
