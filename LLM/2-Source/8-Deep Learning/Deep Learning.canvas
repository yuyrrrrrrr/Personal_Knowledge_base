		},
		{
			"id":"673411f09dd3185c",
			"type":"text",
			"text":"类型与设备转换",
			"styleAttributes":{},
			"x":1267,
			"y":2001,
			"width":260,
			"height":60,
			"color":"3"
		},
		{
			"id":"c9dcc77d9110e68b",
			"type":"text",
			"text":"就地操作(in-place, 带下划线)",
			"styleAttributes":{},
			"x":1267,
