		{"id":"037819813c4aee1e","type":"text","text":"多头注意力(Multi-Head Attention)","x":-1843,"y":1130,"width":250,"height":60,"color":"6"},
		{"id":"e96d085cc4366a8d","type":"text","text":"位置编码(Positional Encoding)","x":-1843,"y":1220,"width":250,"height":60,"color":"6"},
