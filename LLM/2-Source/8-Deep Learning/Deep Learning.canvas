		{"id":"a6082fb2acba0e76","type":"text","text":"LLM","x":-1503,"y":2357,"width":250,"height":60,"color":"6"},
		{"id":"5b3f3fed1c45f555","type":"text","text":"BERT","x":-1500,"y":1602,"width":250,"height":60,"color":"6"},
		{"id":"5186739ddc89053e","type":"text","text":"大模型训练技巧","x":-1849,"y":2180,"width":250,"height":60,"color":"6"},
		{"id":"b92dd2479e01369b","type":"text","text":"模型压缩","x":-1846,"y":2261,"width":250,"height":60,"color":"6"},
		{
			"id":"84cbad79791c91ff",
			"type":"text",
			"text":"黑箱性:深度学习模型通常被视为“黑箱”,因为理解这些模型的内部工作(特别是高层特征的提取和决策过程)非常困难。而传统机器学习方法,如决策树和线性回归,其内部机制通常更容易解释和理解。",
			"styleAttributes":{},
			"x":-850,
			"y":4340,
			"width":260,
			"height":60
		},
