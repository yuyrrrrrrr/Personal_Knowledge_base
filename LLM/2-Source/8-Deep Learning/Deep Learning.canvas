		},
		{"id":"1dfa63df52877a9d","type":"text","text":"GPU加速","x":314,"y":2903,"width":250,"height":60,"color":"3"},
		{"id":"319bcaf4ffe71575","type":"text","text":"nn.Linear, nn.Conv2d, nn.RNN","x":649,"y":2498,"width":250,"height":60,"color":"3"},
		{"id":"89dbeeea3e29637e","type":"text","text":"定义模型","x":649,"y":2121,"width":250,"height":60,"color":"3"},
		{"id":"b2df76bd23ca5a0a","type":"text","text":"定义损失函数和优化器","x":649,"y":2199,"width":250,"height":60,"color":"3"},
		{"id":"baf59df8b0a479e1","type":"text","text":"训练循环","x":649,"y":2276,"width":250,"height":60,"color":"3"},
		{"id":"0e8f4820507fe61b","type":"text","text":"模型保存和加载","x":649,"y":2371,"width":250,"height":60,"color":"3"},
		{
			"id":"fbc5a90c414f9d42",
			"type":"text",
			"text":"模型训练:\n3 + 2 + 5\n3:\n\t3个定义:\n\t\t第一个定义模型\n\t\t第二个定义损失函数\n\t\t第三个定义优化器\n2:\n\t2个遍历:\n\t\t外层遍历轮次,内层遍历批次\n5:\n\t\t前向传播\n\t\t损失计算\n\t\t梯度清零\n\t\t反向传播\n\t\t参数更新",
			"styleAttributes":{},
			"x":937,
			"y":2176,
			"width":260,
			"height":450,
			"color":"3"
		},
		{
			"id":"767c71c52383d699",
			"type":"text",
			"text":"比较逻辑",
			"styleAttributes":{},
			"x":1267,
			"y":1921,
			"width":260,
			"height":60,
			"color":"3"
		},
		{
			"id":"785c2e1dd756cd92",
