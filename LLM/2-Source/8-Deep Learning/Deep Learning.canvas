		{"id":"98772c57e962f15a","type":"text","text":"损失函数选择","x":704,"y":460,"width":250,"height":60,"color":"2"},
		{"id":"0cb05b966c3b968e","type":"text","text":"梯度下降(GD)","x":704,"y":560,"width":250,"height":60,"color":"2"},
		{"id":"8dc1171ad06d6bfd","type":"text","text":"交叉熵损失(Cross Entropy)","x":704,"y":370,"width":250,"height":60,"color":"2"},
		{"id":"39d09af395fe180d","type":"text","text":"自动求导(Autograd)","x":641,"y":1458,"width":250,"height":60,"color":"3"},
		{"id":"b12c689b8f7ba726","type":"text","text":"PyTorch基础","x":314,"y":1518,"width":250,"height":60,"color":"3"},
		{"id":"bf5ee870ccf29275","type":"text","text":"数据加载(DataLoader)","x":641,"y":1578,"width":250,"height":60,"color":"3"},
