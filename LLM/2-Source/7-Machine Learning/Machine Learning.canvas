		{"id":"3a6257b9a8cda82a","type":"text","text":"金融","x":-1940,"y":485,"width":250,"height":60,"color":"6"},
		{"id":"340dba81a34881c6","type":"text","text":"机器学习的应用非常广泛,包括但不限于搜索引擎、推荐系统、语音识别、智能客服、医疗诊断等。","x":-1593,"y":509,"width":250,"height":116,"color":"6"},
		{"id":"1d877aa2063e4da8","type":"text","text":"边学机器学习边看数学,不要死磕","x":-1444,"y":-1843,"width":250,"height":64,"color":"#fb00ff"},
		{"id":"5ed9282e2029d4ac","type":"text","text":"工业","x":-1940,"y":645,"width":250,"height":60,"color":"6"},
		{"id":"46d1279c22373200","type":"text","text":"医疗","x":-1940,"y":565,"width":250,"height":60,"color":"6"},
