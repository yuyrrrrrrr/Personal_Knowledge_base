		{"id":"eb44bb2a-b2a3-51e6-af2f-21307b82c3d3","fromNode":"autoclass","fromSide":"left","toNode":"autoclass-general","toSide":"right"},
		{"id":"8865bb18-6a5f-5303-a3d5-aafb65f83dbc","fromNode":"autoclass-general","fromSide":"left","toNode":"custom-config","toSide":"right"},
		{"id":"311d5b55-480b-56bc-a2e8-5e8f8ed4f5c6","fromNode":"autoclass","fromSide":"left","toNode":"autoclass-task","toSide":"right"},
		{"id":"7a2a87f4-f66c-5880-8348-f9b161b332bf","fromNode":"autoclass-task","fromSide":"left","toNode":"random-head-warning","toSide":"right"},
		{"id":"e2f4d0d3-eb4b-51d9-a409-48c776228988","fromNode":"autoclass","fromSide":"bottom","toNode":"autoclass-choice","toSide":"top"},
		{"id":"8e6c834c-b19d-573c-b635-6029183d3a78","fromNode":"autoclass-choice","fromSide":"left","toNode":"pipeline-fast","toSide":"right"},
		{"id":"679b1fc5-04de-510e-b289-a5574c3ba0cc","fromNode":"autoclass-choice","fromSide":"left","toNode":"concrete-control","toSide":"right"},
		{"id":"74887f50-7947-56e6-ba67-301b7597f7f6","fromNode":"root","fromSide":"top","toNode":"model-chain","toSide":"bottom"},
		{"id":"e1b20e22-ea74-5468-b17e-5c9e6621f3fe","fromNode":"model-chain","fromSide":"top","toNode":"pairing","toSide":"bottom"},
		{"id":"af8d6a99-d273-523a-ab54-496092cd2404","fromNode":"pairing","fromSide":"right","toNode":"tokenizer-mismatch","toSide":"left"},
		{"id":"c24ab2eb-f15a-58de-aa5b-da7b64c15c24","fromNode":"model-chain","fromSide":"top","toNode":"tokenizer","toSide":"bottom"},
		{"id":"2967e1c7-a688-577c-bdc4-0116a47252d1","fromNode":"tokenizer","fromSide":"top","toNode":"input-ids","toSide":"bottom"},
